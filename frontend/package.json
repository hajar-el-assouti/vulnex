{
  "name": "vulnex-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:integration:strict": "STRICT_INTEGRATION=true vitest run --config vitest.integration.config.mts",
    "validate": "npm run lint && npm run typecheck && npm run build && npm run test && npm run test:integration:strict"
  },
  "dependencies": {
