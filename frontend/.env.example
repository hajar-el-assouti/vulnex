# Copy this file to .env.local and adjust if needed. No secrets live here:
# the Next.js app has none of its own -- authentication, sessions and CSRF
# are entirely the FastAPI backend's responsibility (see README.md).

# Server-only (intentionally NOT prefixed with NEXT_PUBLIC_, so it is never
# bundled to the browser). The FastAPI backend's base URL, used by:
#   - the BFF proxy route (src/app/api/v1/[...path]/route.ts)
#   - Server Components that call the backend directly (src/lib/api/server.ts)
#
# Defaults to http://localhost:8001 -- the convention for running FastAPI
# directly in local development (`uvicorn app.main:app --port 8001`),
# chosen so it doesn't collide with anything a developer might already
# have bound to 8000. Docker Compose (backend/docker-compose.yml)
# maps the backend container to host port 8000
# instead -- set this to http://localhost:8000 when running that way.
BACKEND_INTERNAL_URL=http://localhost:8001

# Server-only. Leave unset/false (the secure default) unless this Next.js
# instance itself runs behind its own trusted reverse proxy / load
# balancer that is not reachable except through it, and that proxy
# itself sets (not merely appends to) X-Forwarded-For / X-Real-IP /
# Forwarded from its own observed connection. See the long comment above
# TRUST_UPSTREAM_PROXY_HEADERS in src/app/api/v1/[...path]/route.ts
# before ever setting this to true -- getting this wrong re-opens an
# IP-spoofing path into the backend's rate limiting.
# TRUST_UPSTREAM_PROXY_HEADERS=true
