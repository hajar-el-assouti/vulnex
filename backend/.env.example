# Copy this file to .env and fill in REAL values. Never commit the real .env.
# There are no working defaults anymore: app/core/config.py now requires
# POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB to be set, and fails to
# start otherwise -- on purpose, so a weak/guessable credential can't end up
# running silently.

ENVIRONMENT=development
DEBUG=false
PROJECT_NAME="VULNEX"
API_V1_PREFIX=/api/v1

# --- PostgreSQL ---
# In docker-compose, POSTGRES_HOST is overridden to "postgres" automatically.
POSTGRES_USER=pentest
# Generate a real one, don't type something by hand:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=pentest_saas
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- CORS ---
# JSON array of allowed origins for the frontend.
CORS_ORIGINS=["http://localhost:3000"]

# --- Auth / sessions ---
# Used to sign CSRF tokens (HMAC). Generate a real one, don't type one by hand:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_SECRET_KEY

# Cookie names, session lifetime, idle timeout, login/registration rate
# limiting all have sane defaults in app/core/config.py -- override here
# only if you need something different:
# SESSION_TTL_HOURS=12
# SESSION_IDLE_TIMEOUT_MINUTES=30
# LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
# LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
# REGISTER_RATE_LIMIT_MAX_ATTEMPTS=10
# REGISTER_RATE_LIMIT_WINDOW_SECONDS=3600

# --- Redis (login/registration rate limiting) ---
# Required for /auth/login and /auth/register as of this revision --
# rate limiting is shared via Redis so it holds across replicas, not
# just within one process. In docker-compose this is set automatically
# to redis://redis:6379/0; set it yourself for a non-Docker run.
REDIS_URL=redis://localhost:6379/0

# Secure default: if Redis is unreachable, login/register are refused
# with 503 instead of silently allowing unlimited attempts through.
# Flip to true only if you'd rather keep auth available during a Redis
# outage and accept the brute-force exposure for that window.
# RATE_LIMIT_FAIL_OPEN=false

# --- Generated reports ---
# Where PDF/HTML report files are written (app/core/config.py's
# report_storage_dir). Relative paths resolve against the process's
# CWD (the Dockerfile's WORKDIR /app in docker-compose, where this is
# also backed by the "report_data" named volume -- see
# docker-compose.yml -- so a container rebuild never discards
# previously generated reports). Override only if you need reports on
# a different disk/mount; the default is fine for most setups.
# REPORT_STORAGE_DIR=data/reports

# --- Reverse proxy trust (X-Forwarded-For) ---
# Secure default: X-Forwarded-For is never trusted. Only enable this
# once a real reverse proxy that itself sets/overwrites the header sits
# directly in front of this app, and list exactly that proxy's address
# (or the Docker network it's on) below -- never a wildcard.
# TRUST_X_FORWARDED_FOR=true
# TRUSTED_PROXIES=["172.18.0.0/16"]
